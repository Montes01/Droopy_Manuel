# Normalize all text files to LF in the repo and the working tree.
# Prevents CRLF/LF churn and "LF will be replaced by CRLF" warnings on Windows.
* text=auto eol=lf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.otf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.pdf binary

# Lockfiles are text but diff-noise; keep LF, they are already normalized.
