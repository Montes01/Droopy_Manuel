# URL base del backend (Droopy Manuel API).
#
# En desarrollo, si no defines esta variable, el frontend usa
# http://localhost:3100 automáticamente.
#
# En producción es obligatoria: apunta al dominio donde vive el server.
VITE_API_URL=http://localhost:3100

# Token de Vercel Blob para subir imágenes desde el panel (/api/upload).
# Vercel lo inyecta solo al conectar un Blob store al proyecto; en local
# pégalo aquí para probar subidas en dev.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
